// Cloudflare Workers Static Assets: the static build in ./dist, no Worker script.
//   npm run deploy    (astro build, the 3D desk into dist/fancy/, wrangler deploy)
// The old docs host redirects here: redirect/wrangler.jsonc.
{
	"name": "matenadar",
	"compatibility_date": "2026-11-26",
	"routes": [
		{ "pattern": "matenadar.levships.com", "custom_domain": true }
	],
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	}
}
