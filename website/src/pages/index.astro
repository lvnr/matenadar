<script>
	// ---------------------------------------------------------------- theme
	// Shared with the docs: Starlight reads the same key.
	const root = document.documentElement;
	const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
	const stored = () => {
		try {
			return localStorage.getItem('starlight-theme') || '';
		} catch {
			return '';
		}
	};
	const setTheme = (theme: 'light' | 'dark', keep: boolean) => {
		root.dataset.theme = theme;
		toggle?.setAttribute('aria-label', theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
		if (keep) {
			try {
				localStorage.setItem('starlight-theme', theme);
			} catch {}
		}
	};
	setTheme(root.dataset.theme === 'dark' ? 'dark' : 'light', false);
	toggle?.addEventListener('click', () => setTheme(root.dataset.theme === 'dark' ? 'light' : 'dark', true));
	matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
		if (!stored()) setTheme(e.matches ? 'dark' : 'light', false);
	});

	// ---------------------------------------------------------------- tabs
	for (const list of document.querySelectorAll<HTMLElement>('[role="tablist"]')) {
		const tabs = [...list.querySelectorAll<HTMLElement>('[role="tab"]')];
		const select = (tab: HTMLElement, focus: boolean) => {
			for (const t of tabs) {
				const on = t === tab;
				t.setAttribute('aria-selected', String(on));
				t.tabIndex = on ? 0 : -1;
				const panel = document.getElementById(t.getAttribute('aria-controls') || '');
				if (panel) panel.hidden = !on;
			}
			if (focus) tab.focus();
		};
		list.addEventListener('click', (e) => {
			const tab = (e.target as Element).closest<HTMLElement>('[role="tab"]');
			if (tab) select(tab, false);
		});
		list.addEventListener('keydown', (e) => {
			const i = tabs.indexOf(document.activeElement as HTMLElement);
			if (i < 0) return;
			const next = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
			if (next === undefined) return;
			e.preventDefault();
			select(tabs[(next + tabs.length) % tabs.length], true);
		});
	}

	// ---------------------------------------------------------------- copy
	const announce = document.querySelector<HTMLElement>('[data-announce]');
	document.addEventListener('click', async (e) => {
		const button = (e.target as Element).closest<HTMLButtonElement>('[data-copy]');
		if (!button) return;
		const text = button.dataset.copy || '';
		try {
			await navigator.clipboard.writeText(text);
		} catch {
			const area = Object.assign(document.createElement('textarea'), { value: text });
			area.style.cssText = 'position:fixed;opacity:0';
			document.body.append(area);
			area.select();
			document.execCommand('copy');
			area.remove();
		}
		button.dataset.copied = '';
		const label = button.querySelector('.copy__label');
		if (label) label.textContent = 'Copied';
		if (announce) announce.textContent = 'Copied to the clipboard';
		setTimeout(() => {
			delete button.dataset.copied;
			if (label) label.textContent = 'Copy';
		}, 1600);
	});

	// ---------------------------------------------------------------- specimens
	// A line of the model and the part of the page it made share a data-ref.
	for (const panel of document.querySelectorAll<HTMLElement>('[data-specimen]')) {
		let lit = '';
		const light = (ref: string) => {
			if (ref === lit) return;
			lit = ref;
			for (const el of panel.querySelectorAll('.is-lit')) el.classList.remove('is-lit');
			panel.classList.toggle('is-pointing', ref !== '');
			for (const r of ref.split(' ').filter(Boolean)) {
				for (const el of panel.querySelectorAll(`[data-ref~="${CSS.escape(r)}"]`)) el.classList.add('is-lit');
			}
		};
		panel.addEventListener('pointerover', (e) => {
			const hit = (e.target as Element).closest<HTMLElement | SVGElement>('[data-ref]');
			light(hit?.dataset.ref ?? '');
		});
		panel.addEventListener('pointerleave', () => light(''));
	}

	const guides = document.querySelector<HTMLButtonElement>('[data-guides]');
	guides?.addEventListener('click', () => {
		const on = guides.getAttribute('aria-pressed') !== 'true';
		guides.setAttribute('aria-pressed', String(on));
		document.querySelector('[data-spec]')?.classList.toggle('show-guides', on);
	});
</script>
