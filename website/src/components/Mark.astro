---
/**
 * The mark: Men (Մ), Matenadar's initial in Armenian, drawn as geometry
 * rather than set from a font. Two stems, a half-circle bowl and the arm
 * at the top right, all one 14-unit stroke on a 100-unit grid, in an ink
 * tile. Behind the white glyph sit a cyan and a magenta plate, in register
 * until the brand is pointed at.
 */
interface Props {
	size?: number | string;
	class?: string;
	/** Accessible name; leave empty when the mark sits beside the wordmark. */
	label?: string;
}
const { size = 32, class: className, label } = Astro.props;
const dim = typeof size === 'number' ? `${size}px` : size;
// The glyph's centreline: left stem, bowl, right stem, arm.
const glyph = 'M22.5 14V58A21 21 0 0 0 64.5 58V21H84.5';
---

<svg
	class:list={['mt-mark', className]}
	viewBox="0 0 100 100"
	width={dim}
	height={dim}
	role={label ? 'img' : undefined}
	aria-label={label || undefined}
	aria-hidden={label ? undefined : 'true'}
	focusable="false"
>
	<rect class="mt-mark__tile" width="100" height="100" rx="24"></rect>
	<g transform="translate(50 51) scale(0.6) translate(-50 -50)" fill="none" stroke-width="14" stroke-linejoin="miter">
		<path class="mt-mark__plate mt-mark__plate--c" d={glyph}></path>
		<path class="mt-mark__plate mt-mark__plate--m" d={glyph}></path>
		<path class="mt-mark__glyph" d={glyph}></path>
	</g>
</svg>

<style>
	.mt-mark {
		display: block;
		flex: none;
		overflow: visible;
	}
	.mt-mark__tile {
		fill: var(--mt-fg);
	}
	.mt-mark__glyph {
		stroke: var(--mt-bg);
	}
	.mt-mark__plate {
		transition: transform 0.5s var(--mt-ease, ease);
		mix-blend-mode: screen;
	}
	.mt-mark__plate--c {
		stroke: var(--mt-cyan);
	}
	.mt-mark__plate--m {
		stroke: var(--mt-magenta);
	}
	:global(a:hover) > .mt-mark .mt-mark__plate--c,
	:global(a:focus-visible) > .mt-mark .mt-mark__plate--c {
		transform: translate(-5px, 3px);
	}
	:global(a:hover) > .mt-mark .mt-mark__plate--m,
	:global(a:focus-visible) > .mt-mark .mt-mark__plate--m {
		transform: translate(5px, -3px);
	}
	:global([data-theme='dark']) .mt-mark__plate {
		mix-blend-mode: multiply;
	}
	@media (prefers-reduced-motion: reduce) {
		.mt-mark__plate {
			transition: none;
		}
	}
</style>
