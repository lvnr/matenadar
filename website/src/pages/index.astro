---
/**
 * Matenadar's front page. Every document on it was set by the engine from
 * the JSON shown beside it (scripts/render-examples.py); the page itself is
 * static HTML with one script for motion and the small interactions.
 */
import fs from 'node:fs';
import path from 'node:path';
import Landing from '../layouts/Landing.astro';
import Mark from '../components/Mark.astro';
import Plate, { type Example } from '../components/landing/Plate.astro';
import data from '../data/examples.json';
import { format } from '../lib/jsonfmt';
import { jsonLines } from '../lib/json-lines';

const GITHUB = 'https://github.com/lvnr/matenadar';
const ex = data.examples as unknown as Record<string, Example & { checks?: { severity: string; code: string; page: number; node: string; message: string }[] }>;
const version = data.version;
// Paths from the website's folder, where the build runs.
const read = (id: string) => fs.readFileSync(path.join(process.cwd(), 'examples', id, 'doc.json'), 'utf8');

// The book plate shows one page of the sample: the whole document is long.
const sample = JSON.parse(fs.readFileSync(path.join(process.cwd(), '..', 'samples', 'a-field-guide-to-software-bugs', 'doc.json'), 'utf8'));
const loopPage = sample.content.find((c: { id: string }) => c.id === 'infinite-loop');
// The sample's generator wrote some lengths as 51.839999999999996; show them as 51.84.
const tidy = (v: unknown): unknown =>
	typeof v === 'number' ? Math.round(v * 1e4) / 1e4 : Array.isArray(v) ? v.map(tidy) : v && typeof v === 'object' ? Object.fromEntries(Object.entries(v).map(([k, x]) => [k, tidy(x)])) : v;
const fieldGuideSource = format(tidy(loopPage)) + '\n';

const installs = [
	{ id: 'npx', label: 'npx', cmd: 'npx matenadar build doc.json -o doc.pdf --check' },
	{ id: 'brew', label: 'Homebrew', cmd: 'brew install lvnr/tap/matenadar' },
	{ id: 'cargo', label: 'Cargo', cmd: 'cargo install matenadar' },
	{ id: 'shell', label: 'Shell', cmd: 'curl -fsSL https://github.com/lvnr/matenadar/releases/latest/download/install.sh | sh' },
	{ id: 'wasm', label: 'WebAssembly', cmd: 'npm install @matenadar/wasm' },
];

const kinds = ['Books', 'Invoices', 'Pitch decks', 'Posters', 'Cover wraps', 'Magazines', 'Menus', 'Calendars', 'Reports', 'Certificates', 'Labels', 'Tickets'];
const outputs = ['PDF', 'SVG', 'PNG', 'EPUB 3', 'WebAssembly', 'Rust', 'the command line', 'an agent’s loop'];

// The draft chapter page and its real preflight report.
const draft = ex.draft;
const draftPage = draft.pages[0];
const checks = draft.checks ?? [];
const checkJson = jsonLines(JSON.stringify(checks, null, 2));
const flagged = new Map(checks.map((c) => [c.node, c]));
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
// Short labels for the flags on the page, read from the report's messages.
const flagLabel = (c: { code: string; message: string }) => {
	const n = (re: RegExp) => Math.round(Number(re.exec(c.message)?.[1] ?? NaN));
	if (c.code === 'overflow') return `Overflows by ${n(/runs ([\d.]+) pt/)} pt`;
	if (c.code === 'low-resolution') return `${n(/at (\d+) ppi/)} ppi, needs 300`;
	if (c.code === 'text-in-margin') return 'Inside the spine margin';
	return c.code;
};

const caps = [
	{ name: 'layout', lead: 'Ask where everything landed.', text: 'Every node’s box on every page, in points from the trim corner.', href: '/docs/guides/agents/' },
	{ name: 'locate', lead: 'Point at the page, get the node.', text: 'Any page and point back to the node and the character under it.', href: '/docs/guides/agents/' },
	{ name: 'apply · undo', lead: 'Edit without rewriting the file.', text: 'Reversible operations that return only the pages they changed, and a patch the CLI replays exactly.', href: '/docs/guides/operations/' },
	{ name: 'serve', lead: 'Keep the document warm.', text: 'JSON lines over stdin and stdout, so an agent can change, lay out and check again in milliseconds.', href: '/docs/guides/agents/' },
];

const books = data.books as { slug: string; title: string; pages: { src: string; px: [number, number] }[] }[];
const wall = books.flatMap((b) => b.pages.map((p) => ({ ...p, title: b.title })));
const rowA = wall.filter((_, i) => i % 2 === 0);
const rowB = wall.filter((_, i) => i % 2 === 1);

const anywhere = [
	{
		title: 'Command line',
		text: 'One static binary for macOS, Linux and Windows. Build, check, inspect and serve.',
		href: '/docs/reference/cli/',
		code: ['npx matenadar build doc.json -o doc.pdf --check', 'brew install lvnr/tap/matenadar', 'cargo install matenadar'],
	},
	{
		title: 'WebAssembly',
		text: 'The same engine in a browser worker, Node, Bun or Deno, with an editor’s API.',
		href: '/docs/reference/wasm/',
		code: ['import { Matenadar } from "@matenadar/wasm";', 'const mt = await Matenadar.load();', 'const { pages } = await mt.openFrom(doc, { root: "." });', 'const pdf = mt.pdf();'],
	},
	{
		title: 'Rust',
		text: 'The umbrella crate, or only the model, the layout or the EPUB writer.',
		href: '/docs/reference/rust/',
		code: ['use matenadar::{Document, Paths, Session};', 'let doc = Document::from_json(&json)?;', 'let session = Session::new(doc, paths)?;', 'let pdf = session.pdf()?;'],
	},
];
---

<Landing
	title="Matenadar — every page, programmable"
	description="Matenadar is a typesetting engine for anything that prints: books, invoices, decks, posters, magazines. Describe a document in JSON and get press-ready PDF, SVG, PNG and EPUB 3 in milliseconds, from the command line, Rust or WebAssembly."
	version={version}
>
	<header class="header" data-header>
		<div class="header__bar">
			<a class="brand" href="/" aria-label="Matenadar, home">
				<Mark size={30} />
				<span class="brand__name">Matenadar</span>
			</a>
			<nav class="nav" aria-label="Site">
				<a href="#examples">Examples</a>
				<a href="/docs/">Docs</a>
				<a href="/docs/model/overview/">Model</a>
				<a href={GITHUB} rel="external">GitHub</a>
			</nav>
			<div class="header__end">
				<button class="iconbtn" type="button" data-theme-toggle aria-label="Switch to dark theme">
					<svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"></path></svg>
					<svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.2A8 8 0 0 1 9.8 4a8 8 0 1 0 10.2 10.2z"></path></svg>
				</button>
				<a class="btn btn--primary btn--sm" href="/docs/getting-started/quick-start/">Get started</a>
			</div>
		</div>
	</header>

	<main id="main">
		<section class="hero" aria-labelledby="hero-title">
			<div class="hero__screen" aria-hidden="true"></div>
			<div class="hero__marks" aria-hidden="true">
				<i class="crop crop--tl"></i><i class="crop crop--tr"></i><i class="crop crop--bl"></i><i class="crop crop--br"></i>
				<svg class="reg reg--l" viewBox="0 0 40 40"><circle cx="20" cy="20" r="9"></circle><circle cx="20" cy="20" r="4"></circle><path d="M20 2v36M2 20h36"></path></svg>
				<svg class="reg reg--r" viewBox="0 0 40 40"><circle cx="20" cy="20" r="9"></circle><circle cx="20" cy="20" r="4"></circle><path d="M20 2v36M2 20h36"></path></svg>
			</div>

			<div class="hero__glyph" data-glyph>
				<canvas class="hero__canvas" aria-hidden="true"></canvas>
				<svg class="hero__construct" viewBox="0 0 100 100" aria-hidden="true" data-construct>
					<g class="c-guides">
						<line x1="-16" y1="14" x2="700" y2="14" pathLength="1"></line>
						<line x1="-16" y1="86" x2="700" y2="86" pathLength="1"></line>
						<line x1="-16" y1="58" x2="700" y2="58" class="c-dash"></line>
						<line x1="22.5" y1="2" x2="22.5" y2="160" pathLength="1"></line>
						<line x1="64.5" y1="2" x2="64.5" y2="160" pathLength="1"></line>
						<line x1="43.5" y1="22" x2="43.5" y2="140" class="c-dash"></line>
						<line x1="84.5" y1="6" x2="84.5" y2="36" class="c-dash"></line>
					</g>
					<g class="c-arcs">
						<circle cx="43.5" cy="58" r="21" class="c-dash"></circle>
						<circle cx="43.5" cy="58" r="28" pathLength="1"></circle>
						<circle cx="43.5" cy="58" r="14" pathLength="1"></circle>
						<line x1="43.5" y1="58" x2="58.35" y2="72.85" pathLength="1"></line>
					</g>
					<g class="c-nodes">
						<rect x="21.7" y="13.2" width="1.6" height="1.6"></rect>
						<rect x="21.7" y="57.2" width="1.6" height="1.6"></rect>
						<rect x="63.7" y="57.2" width="1.6" height="1.6"></rect>
						<rect x="63.7" y="20.2" width="1.6" height="1.6"></rect>
						<rect x="83.7" y="20.2" width="1.6" height="1.6"></rect>
						<rect x="42.7" y="78.2" width="1.6" height="1.6"></rect>
						<path d="M42.3 58h2.4M43.5 56.8v2.4"></path>
					</g>
				</svg>
				<span class="glabel" style="left:100%;top:14%">cap height 72</span>
				<span class="glabel" style="left:100%;top:58%">bowl centre</span>
				<span class="glabel glabel--r" style="left:59%;top:74%">r 21</span>
				<output class="readout" data-readout>
					<span class="readout__glyph" lang="hy">Մ</span>
					<span data-readout-text>U+0544 · 14-unit stroke on a 100-unit grid</span>
				</output>
			</div>

			<div class="hero__inner wrap">
				<h1 class="hero__title" id="hero-title">
					<span class="line"><span class="line__in">Every page,</span></span>
					<span class="line line--serif"><span class="line__in">programmable.</span></span>
				</h1>
				<div class="hero__foot">
					<div class="hero__copy">
						<p class="hero__lead" data-fade>
							Matenadar typesets books, invoices, decks, posters and everything between. Describe the document in JSON and get press-ready PDF, SVG, PNG or EPUB&nbsp;3 back in milliseconds, from the command line, from Rust, or in the browser.
						</p>
						<div class="hero__actions" data-fade>
							<a class="btn btn--primary" href="/docs/getting-started/quick-start/">Get started</a>
							<a class="btn btn--ghost" href="#examples">See the examples</a>
						</div>
					</div>
					<div class="install glass" data-tabs data-fade>
						<div class="install__tabs" role="tablist" aria-label="Install">
							{
								installs.map((it, i) => (
									<button type="button" role="tab" id={`tab-${it.id}`} aria-controls={`panel-${it.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
										{it.label}
									</button>
								))
							}
						</div>
						{
							installs.map((it, i) => (
								<div class="install__panel" role="tabpanel" id={`panel-${it.id}`} aria-labelledby={`tab-${it.id}`} hidden={i !== 0}>
									<code class="install__cmd"><span class="install__prompt" aria-hidden="true">$</span>{it.cmd}</code>
									<button class="install__copy" type="button" data-copy={it.cmd} aria-label={`Copy: ${it.cmd}`}>
										<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8.5" y="8.5" width="11" height="11" rx="2"></rect><path d="M5.5 15.5h-.2a1.8 1.8 0 0 1-1.8-1.8V5.3c0-1 .8-1.8 1.8-1.8h8.4c1 0 1.8.8 1.8 1.8v.2"></path></svg>
										<span class="install__copied">Copied</span>
									</button>
								</div>
							))
						}
						<p class="install__meta">Apache-2.0 · Rust, Typst and WebAssembly · v{version}</p>
					</div>
				</div>
			</div>

			<div class="hero__slug" aria-hidden="true">
				<span class="colorbar"><i style="--c:var(--mt-cyan)"></i><i style="--c:var(--mt-magenta)"></i><i style="--c:var(--mt-yellow)"></i><i style="--c:var(--mt-key)"></i><i style="--c:var(--mt-key);opacity:.5"></i><i style="--c:var(--mt-key);opacity:.25"></i></span>
				<span>matenadar {version} · sheet 1 of 1 · set in Instrument Sans and Instrument Serif</span>
			</div>
		</section>

		<section class="marquee" aria-label="What it sets">
			<div class="marquee__row marquee__row--a" aria-hidden="true">
				<div class="marquee__track">{[...kinds, ...kinds].map((k) => <span>{k}<i>·</i></span>)}</div>
			</div>
			<div class="marquee__row marquee__row--b" aria-hidden="true">
				<div class="marquee__track">{[...outputs, ...outputs].map((k) => <span>{k}<i>·</i></span>)}</div>
			</div>
			<p class="visually-hidden">Books, invoices, pitch decks, posters, cover wraps, magazines, menus and calendars, to PDF, SVG, PNG and EPUB 3.</p>
		</section>

		<section class="showcase" id="examples" aria-labelledby="examples-title">
			<div class="showcase__head wrap">
				<h2 class="section-title" id="examples-title" data-reveal>
					One model. <em>Any document.</em>
				</h2>
				<p class="section-lead" data-reveal>
					Every page below was set by Matenadar from the JSON beside it, as you see it: nothing retouched, nothing mocked up. Point at a line to find what it made, or press Inspect to see the layout report.
				</p>
			</div>

			<Plate
				ex={ex.poster}
				word="Poster"
				title="A festival poster, bleed and all."
				text="Eighteen by twenty-four inches with an eighth of an inch of bleed on every side. A title drawn as outlines, a lineup in three columns, a QR code that scans, colours taken from the art."
				file="poster.json"
				source={read('poster')}
				kind="poster"
				bleed={0.125}
				specs={['18 × 24 in + bleed', 'Bricolage Grotesque, Instrument Sans and Serif']}
				alt="A festival poster: Solstice, a halftone sun over pink and blue hills, with the lineup for three nights."
			/>

			<Plate
				ex={ex.invoice}
				word="Invoice"
				title="An invoice that adds up."
				text="A4 with a ruled table of line items, totals, payment details and a QR code to pay by card. Change a line in the JSON, rebuild, and the page follows."
				file="invoice.json"
				source={read('invoice')}
				kind="page"
				flip
				specs={['A4', 'Instrument Sans and Serif, JetBrains Mono']}
				alt="An invoice from Halden & Vey to the Lake Sevan Arts Foundation, with five line items and a total of €16,960."
			/>

			<Plate
				ex={ex.deck}
				word="Deck"
				title="Slides, with charts drawn from data."
				text="Four 16:9 slides from one master: a hero image, big numbers with a sparkline, a bar chart built from rectangles, a quote. Folio and footer come from the master."
				file="deck.json"
				source={read('deck')}
				kind="deck"
				specs={['960 × 540 pt', 'Geist and Instrument Serif']}
				alt="A four-slide pitch deck for Lucent: title slide, traction numbers, a revenue bar chart and a customer quote."
			/>

			<Plate
				ex={ex['field-guide']}
				word="Book"
				title="Pages from a published book."
				text="Two pages of A Field Guide to Software Bugs, rebuilt from the book’s own text and art: a plate inside a plate inside a plate, and a caption set around a circle."
				file="field-guide.json"
				source={fieldGuideSource}
				excerpt="one page of seven"
				kind="spread"
				flip
				specs={['6 × 9 in', 'Adobe Caslon Pro, Big Caslon and Caveat', 'Book by Levon Arakelyan']}
				alt="Two pages from A Field Guide to Software Bugs: The Stack Overflow, with a plate of the page inside itself, and The Infinite Loop, with ants marching in a circle."
			/>

			<Plate
				ex={ex.cover}
				word="Cover"
				title="A cover wrap, spine included."
				text="Back, spine and front on one sheet, with bleed: a blurb over the art behind a soft scrim, type turned to run down the spine, a clear panel where the printer puts the barcode."
				file="cover.json"
				source={read('cover')}
				kind="cover"
				bleed={0.125}
				spine={[441, 484.2]}
				specs={['6 × 9 in, 0.6 in spine, 0.125 in bleed', 'Fraunces, Newsreader, Instrument Sans']}
				alt="A full book cover wrap for The Lighthouse of Lost Pages: a lighthouse built of books on the front, blurb and reviews on the back."
			/>

			<Plate
				ex={ex.magazine}
				word="Magazine"
				title="A magazine feature."
				text="A photograph to the bleed, then two justified columns with a drop cap, a pull quote and a picture cut to a circle. Text and folios on facing pages."
				file="magazine.json"
				source={read('magazine')}
				kind="spread"
				flip
				specs={['8.5 × 11 in pages', 'Newsreader, Instrument Serif and Sans']}
				alt="A magazine spread: hands setting metal type on the left page; the feature The weight of a letter on the right."
			/>

			<div class="duo wrap">
				<Plate
					ex={ex.menu}
					word="Menu"
					title="A menu with dot leaders."
					text="Courses, dishes and prices, the dots run to the price on every line."
					file="menu.json"
					source={read('menu')}
					kind="page"
					specs={['7 × 14 in', 'Fraunces and Newsreader']}
					alt="A dinner menu for Citron with a watercolour of lemons and figs, four courses and prices."
				/>
				<Plate
					ex={ex.calendar}
					word="Calendar"
					title="A month from one element."
					text="The grid, the weekdays and the days around the month come from a single calendar element."
					file="calendar.json"
					source={read('calendar')}
					kind="page"
					specs={['11 × 17 in', 'Instrument Serif and Sans']}
					alt="A wall calendar page for January 2028 with a woodblock print of a lake at dawn."
				/>
			</div>
		</section>

		<section class="books" aria-labelledby="books-title">
			<div class="books__head wrap">
				<h2 class="section-title" id="books-title" data-reveal>
					Real books, <em>rebuilt page for page.</em>
				</h2>
				<p class="section-lead" data-reveal>
					Levon’s published books were first made with hand-written HTML and LaTeX pipelines. To test the model, pages from eight of them were rebuilt in Matenadar from the same text and art. Every page here is the engine’s output.
				</p>
			</div>
			<div class="wall" data-wall>
				{
					[rowA, rowB].map((row, r) => (
						<div class:list={['wall__row', `wall__row--${r ? 'b' : 'a'}`]}>
							<div class="wall__track">
								{[...row, ...row].map((p, i) => (
									<figure class="wall__page" aria-hidden={i >= row.length ? 'true' : undefined}>
										<img src={p.src} width={p.px[0]} height={p.px[1]} alt={i < row.length ? `A page of ${p.title}, rebuilt in Matenadar` : ''} loading="lazy" decoding="async" />
										<figcaption>{p.title}</figcaption>
									</figure>
								))}
							</div>
						</div>
					))
				}
			</div>
		</section>

		<section class="talks" aria-labelledby="talks-title">
			<div class="talks__head wrap">
				<h2 class="section-title" id="talks-title" data-reveal>
					The engine <em>talks back.</em>
				</h2>
				<p class="section-lead" data-reveal>
					Most layout tools are black boxes: markup in, PDF out, and nobody can say why chapter four spilled onto a blank page. Matenadar reports where every node landed and what a printer would reject, in JSON that people and agents can act on.
				</p>
			</div>
			<div class="talks__body wrap">
				<figure class="proof" data-proof>
					<div class="proof__page" style={`--ar: ${draftPage.w} / ${draftPage.h}`}>
						<img src={draftPage.src} width={draftPage.px[0]} height={draftPage.px[1]} alt="A draft chapter opener: the title runs into the spine margin, the picture is low resolution and the text overflows its frame." loading="lazy" decoding="async" />
						<div class="proof__safe" aria-hidden="true" style={`left:${pct(27, draftPage.w)};right:${pct(18, draftPage.w)};top:${pct(18, draftPage.h)};bottom:${pct(18, draftPage.h)}`}></div>
						{
							draftPage.nodes.map((n) => {
								const c = flagged.get(n.id);
								const frameH = n.id === 'opening' ? 96 : undefined;
								return (
									<span
										class:list={['flag', { 'flag--issue': !!c }]}
										data-node={n.id}
										style={`left:${pct(n.r[0], draftPage.w)};top:${pct(n.r[1], draftPage.h)};width:${pct(n.r[2] - n.r[0], draftPage.w)};height:${pct(n.r[3] - n.r[1], draftPage.h)}`}
									>
										{frameH && <i class="flag__frame" style={`height:${pct(frameH, n.r[3] - n.r[1])}`} />}
										<b>{c ? flagLabel(c) : n.id}</b>
									</span>
								);
							})
						}
					</div>
					<figcaption class="proof__caption">A draft chapter opener, 6 × 9 in, with the KDP safe area dashed</figcaption>
				</figure>
				<div class="console glass">
					<div class="code__bar">
						<span class="code__dots" aria-hidden="true"><i></i><i></i><i></i></span>
						<span class="code__file">Terminal</span>
					</div>
					<div class="console__body">
						<p class="console__cmd"><span class="code__prompt" aria-hidden="true">$</span> matenadar check chapter-1.json --preset kdp --json</p>
						<pre class="console__out"><code>{checkJson.map((l) => <span class="ln" set:html={l.html + '\n'} />)}</code></pre>
						<ul class="console__issues">
							{
								checks.map((c) => (
									<li>
										<button type="button" data-issue={c.node}>
											<span class="issue__code">{c.code}</span>
											<span class="issue__node">{c.node}</span>
										</button>
									</li>
								))
							}
						</ul>
						<p class="console__note">The report above is the engine’s real output for this page. Point at a node on the page, or pick an issue, to see them meet.</p>
					</div>
				</div>
			</div>
			<ul class="caps wrap">
				{
					caps.map((c) => (
						<li class="cap" data-reveal>
							<a href={c.href}>
								<code class="cap__name">{c.name}</code>
								<strong class="cap__lead">{c.lead}</strong>
								<span class="cap__text">{c.text}</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<section class="anywhere" aria-labelledby="anywhere-title">
			<div class="anywhere__head wrap">
				<h2 class="section-title" id="anywhere-title" data-reveal>
					Same pixels <em>everywhere.</em>
				</h2>
				<p class="section-lead" data-reveal>
					Every laid-out page carries a fingerprint. What someone edits live in the browser builds to the same PDF on your laptop and in CI.
				</p>
			</div>
			<div class="anywhere__grid wrap">
				{
					anywhere.map((a) => (
						<article class="runtime" data-reveal>
							<h3 class="runtime__title">{a.title}</h3>
							<p class="runtime__text">{a.text}</p>
							<pre class="runtime__code"><code>{a.code.join('\n')}</code></pre>
							<a class="runtime__more" href={a.href}>Reference <span aria-hidden="true">→</span></a>
						</article>
					))
				}
			</div>
		</section>

		<section class="closing" aria-labelledby="closing-title">
			<h2 class="closing__title" id="closing-title">
				<span class="closing__line" data-drift-l>Set your first</span>
				<span class="closing__line closing__line--serif" data-drift-r>page in seconds.</span>
			</h2>
			<div class="closing__body wrap">
				<div class="closing__cmd glass">
					<code><span class="code__prompt" aria-hidden="true">$</span> npx matenadar build doc.json -o doc.pdf --check</code>
					<button class="install__copy" type="button" data-copy="npx matenadar build doc.json -o doc.pdf --check" aria-label="Copy the command">
						<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8.5" y="8.5" width="11" height="11" rx="2"></rect><path d="M5.5 15.5h-.2a1.8 1.8 0 0 1-1.8-1.8V5.3c0-1 .8-1.8 1.8-1.8h8.4c1 0 1.8.8 1.8 1.8v.2"></path></svg>
						<span class="install__copied">Copied</span>
					</button>
				</div>
				<p class="closing__lead">One command. No browser binary, no LaTeX, no account.</p>
				<div class="closing__actions">
					<a class="btn btn--primary btn--lg" href="/docs/getting-started/quick-start/">Start the quick start</a>
					<a class="btn btn--ghost btn--lg" href="/docs/model/overview/">Read about the model</a>
				</div>
			</div>
		</section>
	</main>

	<footer class="footer">
		<div class="footer__maker wrap">
			<div class="maker">
				<p class="maker__title">Made by Levon Arakelyan, in the open.</p>
				<p class="maker__text">
					Matenadar started out of stubbornness: wanting one honest layout engine good enough to typeset real print books, without dragging in headless Chrome or locking manuscripts inside a proprietary editor. It is named after the Matenadaran (<span lang="hy">Մատենադարան</span>), Yerevan’s house of manuscripts, and is free under Apache-2.0.
				</p>
