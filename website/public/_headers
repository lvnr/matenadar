# Cloudflare static assets: cache headers.

# Everything: safe defaults.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: interest-cohort=()

# Hashed build output never changes under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The search index is rebuilt with every deploy, under stable names.
/pagefind/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# The examples' renders, PDFs and JSON: rebuilt by scripts/render-examples.py
# under the same names, so cached briefly and revalidated.
/examples/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The 3D desk (scripts/fancy.sh): hashed scripts and styles never change.
/fancy/assets/*
  Cache-Control: public, max-age=31536000, immutable
