				<div class="actions actions--center">
					<a class="btn btn--primary" href="/docs/getting-started/quick-start/">Start the quick start <span class="btn__arrow" aria-hidden="true">→</span></a>
					<a class="btn btn--secondary" href="/docs/model/overview/">Explore the document model</a>
					<a class="arrowlink" href={GITHUB} rel="external">Star on GitHub&nbsp;↗</a>
