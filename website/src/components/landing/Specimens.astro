---
/**
 * Four specimens: the model (or the commands) beside the page it makes.
 * Every drawing is in points, as the engine measures: trim from the top-left
 * corner, bleed outside it. Lines of code and parts of the drawing share a
 * `data-ref`, and the page lights both when either is pointed at.
 */
import { render, type Line } from '../../lib/highlight';

interface Node {
	ref: string;
	x: number;
	y: number;
	w: number;
	h: number;
	label?: string;
	on?: boolean;
}

/** A label pill's size for a mono label at `size` user units. */
const pill = (size: number, label: string) => ({ w: label.length * size * 0.6 + size * 1.1, h: size * 1.75 });

/* ------------------------------------------------------------------ Book flow */

const flowCode: Line[] = [
	{ t: '{' },
	{ t: '  "matenadar": "1",' },
	{ t: '  "meta": {"title": "The Colophon", "lang": "en-US"},' },
	{ t: '  "design": {' },
	{ t: '    "base": {"font": "Libertinus Serif", "size": 10.5,' },
	{ t: '             "line_height": 1.4},' },
	{ t: '    "styles": {' },
	{ t: '      "body": {"align": "justify", "indent": "1.2em",', ref: 'p-2 p-3' },
	{ t: '               "hyphenate": true},', ref: 'p-2 p-3' },
	{ t: '      "lede": {"inherits": "body",', ref: 'p-1' },
	{ t: '               "drop_cap": {"lines": 3, "color": "#1d4ed8"}},', ref: 'p-1' },
	{ t: '      "kicker": {"size": 7.5, "case": "upper",', ref: 'kicker' },
	{ t: '                 "tracking": "0.3em", "align": "center"},', ref: 'kicker' },
	{ t: '      "h1": {"size": 26, "align": "center"},', ref: 'h-3' },
	{ t: '      "note": {"size": 7.5, "italic": true, "color": "#1d4ed8"}', ref: 'note' },
	{ t: '    },' },
	{ t: '    "masters": {"body": {', ref: 'trim bleed margins notes' },
	{ t: '      "width": "6in", "height": "9in",', ref: 'trim' },
	{ t: '      "bleed": "0.125in",', ref: 'bleed' },
	{ t: '      "margins": {"top": "0.8in", "bottom": "0.9in",', ref: 'margins' },
	{ t: '                  "inside": "0.8in", "outside": "1.6in"},', ref: 'margins' },
	{ t: '      "notes": {"width": "1.1in", "gap": "0.15in",', ref: 'notes' },
	{ t: '                "style": "note"}', ref: 'notes' },
	{ t: '    }}' },
	{ t: '  },' },
	{ t: '  "content": [' },
	{ t: '    {"type": "section", "id": "ch3", "master": "body",', ref: 'ch3' },
	{ t: '     "start": "recto", "flow": [', ref: 'ch3' },
	{ t: '      {"type": "p", "id": "kicker", "style": "kicker",', ref: 'kicker' },
	{ t: '       "text": "Chapter Three"},', ref: 'kicker' },
	{ t: '      {"type": "h", "id": "h-3", "level": 1,', ref: 'h-3' },
	{ t: '       "text": "The Colophon"},', ref: 'h-3' },
	{ t: '      {"type": "p", "id": "p-1", "style": "lede", "content": [', ref: 'p-1' },
	{ t: '        "At the end of a manuscript the scribe wrote a ",', ref: 'p-1' },
	{ t: '        {"text": "colophon", "em": true}, ": who copied …"]},', ref: 'p-1' },
	{ t: '      {"type": "margin", "text": "A note in the outside …"},', ref: 'note' },
	{ t: '      {"type": "p", "id": "p-2", "text": "The book itself …"},', ref: 'p-2' },
	{ t: '      {"type": "figure", "id": "fig-1", "src": "art/leaf.jpg",', ref: 'fig-1' },
	{ t: '       "h": "1.65in", "caption": "A colophon in red ink."},', ref: 'fig-1' },
	{ t: '      {"type": "p", "id": "p-3", "text": "Figures are …"}', ref: 'p-3' },
	{ t: '    ]}' },
	{ t: '  ]' },
	{ t: '}' },
];

// Lines of the page, set as the engine would: justified to the measure.
const flowLines = [
	{ x: 100.6, y: 196, w: 216.2, t: 't the end of a manuscript the scribe wrote a' },
	{ x: 100.6, y: 210.7, w: 216.2, em: 'colophon', t: ': who copied the book, where, and when,' },
	{ x: 100.6, y: 225.4, w: 216.2, t: 'and asked the reader to remember the hand that' },
	{ x: 57.6, y: 240.1, w: 259.2, t: 'made it. Matenadar keeps the same habit: every page' },
	{ x: 57.6, y: 254.8, w: 259.2, t: 'it sets can say what it holds, where each word landed,' },
	{ x: 57.6, y: 269.5, t: 'and which change put it there.' },
	{ x: 70.2, y: 284.2, w: 246.6, t: 'The book itself is a model, a document of sections,' },
	{ x: 57.6, y: 298.9, w: 259.2, t: 'styles, masters and components. Typst sets the type:' },
	{ x: 57.6, y: 313.6, w: 259.2, t: 'it breaks a whole paragraph at a time, hyphenates by' },
	{ x: 57.6, y: 328.3, w: 259.2, t: 'the language, and keeps a lone line from the top of a' },
	{ x: 57.6, y: 343, w: 259.2, t: 'page. Change the model and the pages follow, set again' },
	{ x: 57.6, y: 357.7, t: 'in milliseconds.' },
	{ x: 57.6, y: 540, w: 259.2, t: 'Figures are numbered in the order they stand in the' },
	{ x: 57.6, y: 554.7, w: 259.2, t: 'book, wherever a float or a plate puts them, and the' },
	{ x: 57.6, y: 569.4, w: 259.2, t: 'list of figures finds each by its id, on whatever page' },
];

const flowNodes: Node[] = [
	{ ref: 'ch3', x: 57.6, y: 57.6, w: 259.2, h: 525.6, label: 'ch3 · section · 259 × 526 pt' },
	{ ref: 'kicker', x: 57.6, y: 96, w: 259.2, h: 12, label: 'kicker · p' },
	{ ref: 'h-3', x: 57.6, y: 117, w: 259.2, h: 30, label: 'h-3 · h · 259 × 30 pt' },
	{ ref: 'p-1', x: 57.6, y: 186, w: 259.2, h: 88, label: 'p-1 · p · drop cap, 3 lines' },
	{ ref: 'note', x: 327.6, y: 188, w: 79.2, h: 41, label: 'margin · note column' },
	{ ref: 'p-2', x: 57.6, y: 275, w: 259.2, h: 88, label: 'p-2 · p · 259 × 88 pt' },
	{ ref: 'fig-1', x: 57.6, y: 377, w: 259.2, h: 142, label: 'fig-1 · figure · 259 × 142 pt' },
	{ ref: 'p-3', x: 57.6, y: 531, w: 259.2, h: 44, label: 'p-3 · p · runs on to page 18' },
];

/* ------------------------------------------------------------------ Designed spread */

const spreadCode: Line[] = [
	{ t: '"content": [' },
	{ t: '  …,' },
	{ t: '  {"type": "spread", "id": "s-lamps", "master": "picture",', ref: 's-lamps' },
	{ t: '   "src": "art/lamplighter.jpg", "focus": [0.5, 0.6],', ref: 's-lamps' },
	{ t: '   "gutter": "0.125in",', ref: 'gutter' },
	{ t: '   "alt": "A hill road at dusk, its lamps lit one by one.",', ref: 's-lamps' },
	{ t: '   "left": {"elements": [', ref: 'verso' },
	{ t: '     {"type": "text", "id": "words", "x": "0.6in", "y": "0.7in",', ref: 'words origin' },
	{ t: '      "w": "3.2in", "safe": true, "style": "story",', ref: 'words safe' },
	{ t: '      "text": "Every evening, Ani lit the lamps, one by one.",', ref: 'words' },
	{ t: '      "scrim": {"color": "#ffffff", "opacity": 0.85,', ref: 'scrim' },
	{ t: '                "feather": "10pt", "inset": "8pt",', ref: 'scrim' },
	{ t: '                "radius": "6pt"}}', ref: 'scrim' },
	{ t: '   ]},' },
	{ t: '   "right": {"elements": [', ref: 'recto' },
	{ t: '     {"type": "lettering", "id": "title",', ref: 'title' },
	{ t: '      "text": "THE LAMPLIGHTER", "font": "Futura",', ref: 'title' },
	{ t: '      "size": 30, "tracking": "0.14em", "color": "#ffffff",', ref: 'title' },
	{ t: '      "x": "1.4in", "y": "2.6in",', ref: 'title' },
	{ t: '      "path": "M 0 120 A 320 320 0 0 1 420 120",', ref: 'arc' },
	{ t: '      "start": "50%", "align": "center", "decorative": true}', ref: 'title' },
	{ t: '   ]}}' },
	{ t: '],' },
	{ t: '"on_page": {"s-lamps": {"hide": ["folio"]}}', ref: 'folio' },
];

// A seeded scatter of stars, the same on every build.
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const stars = Array.from({ length: 52 }, () => ({
	x: Math.round(rand() * 1230 - 6),
	y: Math.round(rand() * 320 - 4),
	r: +(0.7 + rand() * 1.3).toFixed(2),
	o: +(0.35 + rand() * 0.6).toFixed(2),
}));
const lamps = [
	{ x: 292, y: 538, lit: true },
	{ x: 520, y: 500, lit: true },
	{ x: 760, y: 470, lit: true },
	{ x: 980, y: 452, lit: false },
	{ x: 1160, y: 441, lit: false },
];

const spreadNodes: Node[] = [
	{ ref: 's-lamps', x: -9, y: -9, w: 1242, h: 630, label: 's-lamps · spread · 17 × 8.5 in' },
	{ ref: 'words', x: 35.2, y: 42.4, w: 246.4, h: 96, label: 'words · text · safe' },
	{ ref: 'title arc', x: 702, y: 212, w: 440, h: 108, label: 'title · lettering · decorative' },
];

/* ------------------------------------------------------------------ Agent loop & preflight */

const agentCode: Line[] = [
	{ t: '$ matenadar layout book.json --pages 42' },
	{ t: '[{"page": 42, "label": "42", "width": 432.0,', ref: 'page' },
	{ t: '  "height": 648.0, "nodes": [', ref: 'page' },
	{ t: '  {"id": "p-13", "kind": "p", "rect": {"x0": 54.0, …}},', ref: 'p-13' },
	{ t: '  {"id": "h-7", "kind": "h", "rect": {"x0": 54.0, …}},', ref: 'h-7' },
	{ t: '  {"id": "p-14", "kind": "p", "rect": {"x0": 54.0, …}},', ref: 'p-14' },
	{ t: '  {"id": "pull-2", "kind": "box", "rect": {"x0": 3.6, …}},', ref: 'pull-2' },
	{ t: '  {"id": "p-15", "kind": "p", "rect": {"x0": 54.0, …}}]}]', ref: 'p-15' },
	{ t: '' },
	{ t: '$ matenadar locate book.json --page 42 --x 212 --y 148', ref: 'locate' },
	{ t: '{"node":"p-14","offset":118}', ref: 'locate p-14' },
	{ t: '' },
	{ t: '$ matenadar check book.json --json' },
	{ t: '[' },
	{ t: '  {' },
	{ t: '    "severity": "warning",', ref: 'p-13' },
	{ t: '    "code": "widow",', ref: 'p-13' },
	{ t: '    "page": 42,', ref: 'p-13' },
	{ t: '    "node": "p-13",', ref: 'p-13' },
	{ t: '    "message": "p-13 carries one line to the top of page 42"', ref: 'p-13' },
	{ t: '  },' },
	{ t: '  {' },
	{ t: '    "severity": "error",', ref: 'pull-2 safe' },
	{ t: '    "code": "text-in-margin",', ref: 'pull-2 safe' },
	{ t: '    "page": 42,', ref: 'pull-2' },
	{ t: '    "node": "pull-2",', ref: 'pull-2' },
	{ t: '    "message": "2 runs of live text sit inside the safe margin …"', ref: 'pull-2 safe' },
	{ t: '  }' },
	{ t: ']' },
];

const agentBars = (() => {
	const out: { x: number; y: number; w: number }[] = [];
	[136, 150.7, 165.4, 180.1, 194.8, 209.5].forEach((b, i) => out.push({ x: 54, y: b - 6, w: i === 5 ? 196 : 315 }));
	for (let i = 0, b = 330; b <= 578; i++, b += 14.7) out.push({ x: i === 0 ? 66.6 : 54, y: b - 6, w: i === 0 ? 302.4 : 315 });
	return out;
})();

const agentNodes: Node[] = [
	{ ref: 'page', x: 0, y: 0, w: 432, h: 648, label: 'page 42 · verso · 432 × 648 pt' },
	{ ref: 'p-13', x: 54, y: 56, w: 315, h: 13, on: true },
	{ ref: 'h-7', x: 54, y: 86, w: 315, h: 27, label: 'h-7 · h · 315 × 27 pt', on: true },
	{ ref: 'p-14', x: 54, y: 126, w: 315, h: 88, label: 'p-14 · p · 315 × 88 pt', on: true },
	{ ref: 'pull-2', x: 3.6, y: 226, w: 230, h: 76, on: true },
	{ ref: 'p-15', x: 54, y: 318, w: 315, h: 254, label: 'p-15 · p · 315 × 254 pt', on: true },
];

const flags = [
	{ ref: 'p-13', kind: 'warn', x: 214, y: 70, label: 'widow · p-13 · carried from page 41' },
	{ ref: 'pull-2', kind: 'err', x: 3.6, y: 222, label: 'text-in-margin · pull-2' },
	{ ref: 'locate p-14', kind: 'accent', x: 222, y: 140, label: 'locate → p-14 · offset 118' },
];

/* ------------------------------------------------------------------ Browser WASM & EPUB 3 */

const wasmCode: Line[] = [
	{ t: 'import { MatenadarClient } from "@matenadar/wasm/client";', ref: 'worker' },
	{ t: '' },
	{ t: 'const mt = await MatenadarClient.start({', ref: 'worker' },
	{ t: '  wasm: "https://cdn.jsdelivr.net/npm/@matenadar/wasm"', ref: 'worker cdn' },
	{ t: '      + "@0.2.0/dist/matenadar.wasm",', ref: 'worker cdn' },
	{ t: '});', ref: 'worker' },
	{ t: 'for (const font of fonts) await mt.addFont(font);' },
	{ t: 'const { pages } = await mt.open(doc);', ref: 'page' },
	{ t: 'view.innerHTML = await mt.svg(1, { bleed: true });', ref: 'page' },
	{ t: '' },
	{ t: '// the pointer, back to the model' },
	{ t: 'const hit = await mt.hit(1, x, y);', ref: 'hit' },
	{ t: 'const done = await mt.setBlock(hit.id, {', ref: 'space' },
	{ t: '  space_before: "12pt",', ref: 'space' },
	{ t: '});', ref: 'space' },
	{ t: 'for (const n of done.changed_pages) redraw(n);', ref: 'space' },
	{ t: 'await mt.undo();', ref: 'undo' },
	{ t: '' },
	{ t: '// the same book, for a reader', ref: 'epub' },
	{ t: 'const epub = await mt.epub({ layout: "fixed" });', ref: 'epub' },
	{ t: '' },
	{ t: '// the same pages as `matenadar fingerprint`', ref: 'fp' },
	{ t: 'const hashes = await mt.fingerprint();', ref: 'fp' },
];

const wasmNodes: Node[] = [
	{ ref: 'page', x: 99, y: 70, w: 260, h: 380, label: 'svg(1) · page 1' },
	{ ref: 'hit', x: 121, y: 202, w: 216, h: 58, label: 'hit → p-b · p · offset 42' },
	{ ref: 'epub', x: 470, y: 64, w: 210, h: 400, label: 'EPUB 3 · fixed layout · live text' },
];

const tabs = [
	{
		id: 'flow',
		name: 'Book Flow',
		desc: 'A section poured through a master.',
		file: 'book.json',
		lang: 'JSON',
		note: 'Margins that mirror, a note column, a drop cap and a figure. Every box is what matenadar layout reports.',
		href: '/docs/model/overview/',
		more: 'The document model',
	},
	{
		id: 'spread',
		name: 'Designed Spread',
		desc: 'Two pages under one picture.',
		file: 'picture-book.json',
		lang: 'JSON',
		note: 'The gutter strip repeats across the fold; the lettered title is decorative, so it may cross the bleed and still pass print-margin checks.',
		href: '/docs/model/content/#spreads',
		more: 'Spreads and elements',
	},
	{
		id: 'agent',
		name: 'Agent Loop & Preflight',
		desc: 'What an agent reads instead of a PDF.',
		file: 'terminal',
		lang: 'Shell',
		note: 'Output abridged. Issues carry stable codes, the page and the node’s id, and check exits with status 1 on an error.',
		href: '/docs/guides/agents/',
		more: 'Working with agents',
	},
	{
		id: 'wasm',
		name: 'Browser WASM & EPUB 3',
		desc: 'The same engine in a worker.',
		file: 'editor.js',
		lang: 'JavaScript',
		note: 'Each edit is one undo step and returns only the pages to draw again. The worker stays on your origin; the module can come from jsDelivr.',
		href: '/docs/reference/wasm/',
		more: 'The WebAssembly API',
	},
];
const code = { flow: render(flowCode, 'json'), spread: render(spreadCode, 'json'), agent: render(agentCode, 'sh'), wasm: render(wasmCode, 'js') };
---

<div class="spec show-guides" data-spec>
	<!-- Shared paint servers, kept rendered (patterns in display:none SVGs don't paint). -->
	<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
		<defs>
			<pattern id="sp-hatch" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
				<rect width="5" height="5" fill="rgba(220,38,38,0.1)"></rect>
				<line x1="0" y1="0" x2="0" y2="5" stroke="#dc2626" stroke-width="1.2" stroke-opacity="0.55"></line>
			</pattern>
			<linearGradient id="sp-dusk" x1="0" y1="0" x2="0" y2="1">
				<stop offset="0" stop-color="#070b1f"></stop>
				<stop offset="0.42" stop-color="#18245a"></stop>
				<stop offset="0.7" stop-color="#3f4f9a"></stop>
				<stop offset="0.88" stop-color="#9a8fc4"></stop>
				<stop offset="1" stop-color="#e9b7a6"></stop>
			</linearGradient>
			<radialGradient id="sp-glow">
				<stop offset="0" stop-color="#ffe3a3" stop-opacity="0.85"></stop>
				<stop offset="1" stop-color="#ffe3a3" stop-opacity="0"></stop>
			</radialGradient>
			<filter id="sp-feather" x="-20%" y="-20%" width="140%" height="140%">
				<feGaussianBlur stdDeviation="5"></feGaussianBlur>
			</filter>
			<filter id="sp-shadow" x="-20%" y="-20%" width="140%" height="140%">
				<feGaussianBlur stdDeviation="9"></feGaussianBlur>
			</filter>
		</defs>
	</svg>

	<div class="spec__top">
		<div class="spec__tabs" role="tablist" aria-label="Specimens">
			{
				tabs.map((t, i) => (
					<button
						class="spec__tab"
						role="tab"
						type="button"
						id={`tab-${t.id}`}
						aria-controls={`panel-${t.id}`}
						aria-selected={i === 0 ? 'true' : 'false'}
						tabindex={i === 0 ? 0 : -1}
					>
						<span class="spec__tab-name">{t.name}</span>
						<span class="spec__tab-desc">{t.desc}</span>
					</button>
				))
			}
		</div>
		<button class="switch" type="button" data-guides aria-pressed="true">
			<span class="switch__track" aria-hidden="true"></span>
			Guides
		</button>
	</div>

	{
		tabs.map((t, i) => (
			<div class="spec__panel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} data-specimen hidden={i !== 0}>
				<div class="app">
					<div class="app__bar">
						<span class="app__dots" aria-hidden="true">
							<i />
							<i />
							<i />
						</span>
						<span class="app__tab">{t.file}</span>
						<span class="app__meta">{t.lang} · preview</span>
					</div>
					<div class="app__split">
						<pre class="app__code" tabindex="0" aria-label={`${t.name}: ${t.lang}`}><code set:html={code[t.id as keyof typeof code]} /></pre>
						<div class="app__canvas">
							{t.id === 'flow' && (
								<svg class="sp" viewBox="-30 -36 520 712" role="img" aria-labelledby="sp1-title sp1-desc">
									<title id="sp1-title">A recto page set from the model</title>
									<desc id="sp1-desc">
										A 6 by 9 inch recto page: a chapter kicker and heading, a lede paragraph with a three-line drop cap, a
										margin note in the outside column, a second paragraph, a figure with its caption, and running text.
										Guides show the trim, the bleed on the top, bottom and outside edges, the margins and the note column.
									</desc>
									<rect class="shade" x="4" y="0" width="441" height="666" />
									<rect class="sheet" x="0" y="-9" width="441" height="666" />

									<g class="g">
										<rect class="trim" data-ref="trim" x="0" y="0" width="432" height="648" />
										<rect class="bleed" data-ref="bleed" x="0" y="-9" width="441" height="666" />
										<rect class="margin" data-ref="margins" x="57.6" y="57.6" width="259.2" height="525.6" />
										<rect class="notes" data-ref="notes" x="327.6" y="57.6" width="79.2" height="525.6" />
										<g data-ref="trim">
											<text class="anno anno--muted" x="0" y="-18">trim 6 × 9 in · recto</text>
										</g>
										<g data-ref="bleed">
											<text class="anno anno--bleed" transform="translate(452 24) rotate(90)">bleed 0.125 in · top, bottom, outside</text>
										</g>
										<g data-ref="margins">
											<path class="dim" d="M316.8 28V36M432 28V36M316.8 32H432" />
											<text class="anno" x="321" y="23">outside 1.6 in</text>
											<path class="dim" d="M0 28V36M57.6 28V36M0 32H57.6" />
											<text class="anno anno--fine" x="3" y="23">inside 0.8</text>
										</g>
										<g data-ref="notes">
											<text class="anno" transform="translate(400 66) rotate(90)">notes 1.1 in</text>
										</g>
									</g>

									<text class="txt txt--sans txt--accent" x="187.2" y="105" text-anchor="middle" font-size="7.5" letter-spacing="2.25">CHAPTER THREE</text>
									<text class="txt" x="187.2" y="141" text-anchor="middle" font-size="26">The Colophon</text>
									<text class="txt txt--accent" x="56" y="225.4" font-size="56">A</text>
									{flowLines.map((l) => (
										<text class="txt" x={l.x} y={l.y} font-size="10.5" textLength={l.w} lengthAdjust={l.w ? 'spacing' : undefined}>{l.em && <tspan font-style="italic">{l.em}</tspan>}{l.t}</text>
									))}
									<g class="txt txt--accent" font-size="7.5" font-style="italic">
										<text x="327.6" y="196">A note in the</text>
										<text x="327.6" y="205.75">outside column,</text>
										<text x="327.6" y="215.5">level with the</text>
